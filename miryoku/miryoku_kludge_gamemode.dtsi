// GameMode: combo Sym+Num+Fun (left three thumbs) -> &mo U_GAME.

#if defined (MIRYOKU_KLUDGE_GAMEMODE) && defined (MIRYOKU_KLUDGE_GAMEMODE_LEFT_THUMBS)

/ {
  combos {
    compatible = "zmk,combos";

    gamemode_combo_on {
      key-positions = <MIRYOKU_KLUDGE_GAMEMODE_LEFT_THUMBS>;
      // Toggle GameMode when the 3-thumb chord is pressed.
      // Base/other -> Game (disable other non-default layers).
      bindings = <&to U_GAME>;
      // When holding Sym+Num+Fun together, make sure combo resolves before
      // the thumb hold-taps fully commit, and keep GameMode active while
      // all three keys are held.
      timeout-ms = <50>;
      // Allow the combo to be evaluated regardless of which layer the thumb
      // hold-taps might have temporarily selected.
      layers = <U_BASE U_EXTRA U_NUM U_SYM U_FUN>;
    };

    gamemode_combo_off {
      key-positions = <MIRYOKU_KLUDGE_GAMEMODE_LEFT_THUMBS>;
      // Game -> Base (disable other non-default layers).
      bindings = <&to U_BASE>;
      timeout-ms = <50>;
      layers = <U_GAME>;
    };
  };
};

#endif
