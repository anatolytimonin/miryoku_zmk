// GameMode: combo Sym+Num+Fun (left three thumbs) -> &mo U_GAME.

#if defined (MIRYOKU_KLUDGE_GAMEMODE) && defined (MIRYOKU_KLUDGE_GAMEMODE_LEFT_THUMBS)

/ {
  combos {
    compatible = "zmk,combos";
    gamemode_combo {
      key-positions = <MIRYOKU_KLUDGE_GAMEMODE_LEFT_THUMBS>;
      bindings = <&mo U_GAME>;
      // GameMode should activate immediately from the base/extra chord.
      // Keep the combo window tiny so it resolves before thumb hold-taps
      // switch into U_SYM/U_NUM/U_FUN layers.
      timeout-ms = <20>;
      layers = <U_BASE U_EXTRA>;
    };
  };
};

#endif
